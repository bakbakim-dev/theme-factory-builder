WHIPIFY_ADMIN_REQUIRE_AUTH=1
WHIPIFY_ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
WHIPIFY_ADMIN_EMAIL=admin@example.com
WHIPIFY_ADMIN_PASSWORD=replace-with-a-strong-password
WHIPIFY_ADMIN_TENANT_NAME=Whipify Admin
WHIPIFY_ADMIN_TENANT_SLUG=whipify-admin
WHIPIFY_ADMIN_DISPLAY_NAME=Whipify Admin
WHIPIFY_ADMIN_STORAGE=/data/whipify-admin
WHIPIFY_ADMIN_PORT=8787
WHIPIFY_ADMIN_ENABLE_PRODUCTION_INFRA=1
WHIPIFY_PREVIEW_BASE_URL=https://preview.example.com
WHIPIFY_ARTIFACT_BASE_URL=https://artifacts.example.com
WHIPIFY_RATE_LIMIT_MAX=120
WHIPIFY_RATE_LIMIT_WINDOW_MS=60000
